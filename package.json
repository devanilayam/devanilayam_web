{
	"name": "devanilayam_web",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare && (commitguard install || true)",
		"build:icons": "bun run generate-icon-fonts.ts",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:style": "stylelint \"app/**/*.{scss,vue}\"",
		"lint:style:fix": "stylelint \"app/**/*.{scss,vue}\" --fix",
		"typecheck": "vue-tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"pwa:icons": "bun run scripts/pwa/icons.mjs",
		"pwa:verify": "bash scripts/pwa/verify.sh",
		"seo:verify": "bash scripts/seo/verify.sh",
		"seo:lighthouse": "bash scripts/seo/lighthouse.sh",
		"seo:lighthouse:mobile": "bash scripts/seo/lighthouse.sh lighthouserc.mobile.json",
		"release": "semantic-release"
	},
	"overrides": {
		"unhead": "^3.4.0"
	},
	"dependencies": {
		"@nuxt/content": "^3.8.2",
		"@nuxt/fonts": "^0.14.0",
		"@nuxt/image": "^2.1.0",
		"@nuxtjs/seo": "^5.3.14",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^1.3.1",
		"@vite-pwa/nuxt": "^1.1.1",
		"better-sqlite3": "^12.4.6",
		"nuxt": "^4.5.0",
		"vue": "^3.5.24",
		"vue-router": "^4.6.3"
	},
	"devDependencies": {
		"@moulibheemaneti/commitguard": "^0.1.4",
		"@nuxt/eslint": "^1.10.0",
		"@nuxt/test-utils": "^4.1.0",
		"@nuxtjs/i18n": "^10.2.1",
		"@resvg/resvg-js": "^2.6.2",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.9",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@stylistic/stylelint-plugin": "^5.3.0",
		"@vitest/coverage-v8": "^4.1.11",
		"@vue/test-utils": "^2.4.11",
		"@vueuse/core": "^14.0.0",
		"conventional-changelog-conventionalcommits": "^8.0.0",
		"eslint": "^10.9.0",
		"fantasticon": "^3.0.0",
		"happy-dom": "^20.11.6",
		"postcss-html": "^2.0.0",
		"sass": "^1.96.0",
		"sass-embedded": "^1.103.1",
		"sass-true": "^10.1.0",
		"satori": "^0.33.3",
		"semantic-release": "^25.0.9",
		"stylelint": "^17.14.1",
		"stylelint-config-standard-scss": "^17.0.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11",
		"vue-tsc": "^3.3.11"
	}
}
