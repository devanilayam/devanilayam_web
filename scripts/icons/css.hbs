@font-face {
    font-family: "{{ name }}";
    src: {{{ fontSrc }}};
    /* `block` rather than `swap`: these glyphs live in the Private Use Area, so
       a fallback face renders them as tofu boxes. Better a brief blank than a
       flash of boxes — and the subsetted font is ~2 KB, so the block period is
       effectively never reached. */
    font-display: block;
}

{{# if selector }}
{{ selector }}:before {
{{ else }}
{{ tag }}[class^="{{prefix}}-"]:before, {{ tag }}[class*=" {{prefix}}-"]:before {
{{/ if }}
    font-family: {{ name }} !important;
    font-style: normal;
    font-weight: normal !important;
    font-variant: normal;
    text-transform: none;
    line-height: 1;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

{{# each codepoints }}
{{# if ../selector }}
{{ ../selector }}.{{ ../prefix }}-{{ @key }}:before {
{{ else }}
.{{ ../prefix }}-{{ @key }}:before {
{{/ if }}
    content: "\\{{ codepoint this }}";
}
{{/ each }}
